{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.1",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://grunq.com/grunq-signer/",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "signer@grunq.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/grunq-16.png",
    "32": "icons/grunq-32.png",
    "48": "icons/grunq-48.png",
    "128": "icons/grunq-128.png"
  },
  "background": {
    "service_worker": "background/index.js",
    "scripts": [
      "background/index.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/inpage.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/grunq-16.png",
      "32": "icons/grunq-32.png",
      "48": "icons/grunq-48.png",
      "128": "icons/grunq-128.png"
    }
  }
}
